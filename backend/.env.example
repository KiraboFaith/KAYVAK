# Copy this file to backend/.env and fill it in. backend/.env is never committed.
KAYVAK_SMTP_HOST=smtp.gmail.com
KAYVAK_SMTP_PORT=465
KAYVAK_SMTP_USER=youraddress@gmail.com
# For Gmail this is an "app password", not your normal password
KAYVAK_SMTP_PASSWORD=your-16-letter-app-password
KAYVAK_EMAIL_TO=youraddress@gmail.com